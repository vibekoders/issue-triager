# Copy to .env (loaded by devenv, and by the `service` container in
# docker-compose.yaml).

# --- Choose your provider -----------------------------------------------------
# The experiments (run-experiments) take every model from one profile in
# evals/experiments/profiles.yaml. Pick one and set its key(s); the Rust
# service (strategies) and the Python judge read the same variables.
#
#   openai     (default) GPT-6 Luna/Sol            OPENAI_API_KEY
#   anthropic  Claude Haiku 4.5 / Sonnet 5         ANTHROPIC_API_KEY
#   gemini     Gemini 3.5 Flash-Lite / 3.1 Pro     GEMINI_API_KEY
#   azure      Azure OpenAI GPT-6 deployments      AZURE_OPENAI_RESOURCE, AZURE_OPENAI_API_KEY
#   local      everything on Ollama (no keys, slow on CPU)
#
# Every hosted profile also uses TypeSafe's Jev as the decision model
# (Workflow, Ensemble and DraftVerify), so set TYPESAFE_API_KEY too. Their
# decision_alt is the local tev1 on Ollama, used only by the
# workflow-decision-alt step: without an Ollama, skip that step or override it
# (--model decision_alt=...).
EXPERIMENT_PROFILE=openai

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Read by both the service and the judge (GOOGLE_API_KEY works too, but set
# only one of them: the service prefers GEMINI_API_KEY, pydantic-ai
# GOOGLE_API_KEY).
GEMINI_API_KEY=
# Azure OpenAI: the resource name (https://<resource>.openai.azure.com) or the
# full endpoint, and its key. The profile expects deployments named
# gpt-6-luna and gpt-6-sol.
AZURE_OPENAI_RESOURCE=
#AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Jev decision models (typesafe:jev-latest), for every hosted profile.
TYPESAFE_API_KEY=

# Traces go to Logfire only when this is set.
LOGFIRE_TOKEN=
# Logfire's deployment environment (deployment.environment.name) for the
# harness and the Rust service, e.g. dev or my-sandbox.
#LOGFIRE_ENVIRONMENT=
# Logfire region of the token, for the Restate server's OTLP exporter: eu or us.
LOGFIRE_REGION=eu

# GitHub token for fetching issues. `gh auth token` works too.
GITHUB_TOKEN=

# Ollama, as reached from the host (the Rust service reads OLLAMA_HOST, the
# Python judge OLLAMA_BASE_URL). docker-compose.yaml sets OLLAMA_HOST for the
# `service` container itself (http://ollama:11434).
OLLAMA_HOST=http://localhost:11434
#OLLAMA_BASE_URL=http://localhost:11434/v1

# Other providers (optional; only for configs that name them; see
# crates/triage-service/README.md for the other provider keys).
# Workers AI chat and Clef decision models (cloudflare:...).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# The Rust service (defaults shown).
#LISTEN_ADDR=0.0.0.0:9080
#CORPUS_DIR=./data/corpus

# Restate, as reached from the host.
RESTATE_INGRESS_URL=http://localhost:8080
RESTATE_ADMIN_URL=http://localhost:9070
# The service, as reached from the Restate container; the harness registers
# this URL with Restate before a run. The default is the service running on
# the host (`cargo run -- serve`). When the service runs in docker compose
# instead (`docker compose --profile app up -d`), use the container:
#SERVICE_URL=http://service:9080
SERVICE_URL=http://host.docker.internal:9080

# Models for run-experiments (evals/experiments/profiles.yaml). The profile sets every
# model role; these override it, and --profile / --model ROLE=ADDRESS
# override these.
# (EXPERIMENT_PROFILE is set at the top.)
#EXPERIMENT_MODEL_LLM=openai:gpt-6-luna
#EXPERIMENT_MODEL_LLM_LARGE=openai:gpt-6-sol
#EXPERIMENT_MODEL_DECISION=typesafe:jev-latest
#EXPERIMENT_MODEL_DECISION_ALT=ollama:tev1:0.8b-q8_0
#EXPERIMENT_MODEL_JUDGE=openai:gpt-6-luna

# Judge model for pydantic-evals' LLMJudge (a pydantic-ai model string), the
# default for triage-eval (else ollama:qwen3:4b). run-experiments reads it as
# an alias of EXPERIMENT_MODEL_JUDGE, so when set it overrides every profile's
# judge. PLAN.md wants a judge from another model family than the strategies;
# the local default is Qwen like them, so judged scores may carry
# self-preference bias. For judged results anyone relies on, use another
# family, e.g. ollama:llama3.2:3b, ollama:gemma3:4b or a hosted model.
#JUDGE_MODEL=ollama:qwen3:4b

# Restate node name (keep it stable; must match the data in the restate-data volume).
# RESTATE_NODE_NAME=restate
